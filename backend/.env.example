# Database Configuration
DB_HOST=database
DB_PORT=5432
DB_NAME=saas_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-unique-database-password

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h

# Seed account passwords
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-unique-password
SEED_TENANT_ADMIN_PASSWORD=replace-with-a-unique-password
SEED_USER_PASSWORD=replace-with-a-unique-password

# Frontend URL (for CORS)
FRONTEND_URL=http://frontend:3000